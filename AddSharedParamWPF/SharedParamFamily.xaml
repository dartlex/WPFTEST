<Window x:Class="AddSharedParamWPF.SharedParamFamily"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AddSharedParamWPF"
        mc:Ignorable="d"
        Title="Add Shared Parameters" Height="500" Width="500"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- 0: Верхняя панель (Путь к ФОП) -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Центральная панель (Список параметров) -->
            <RowDefinition Height="*"/>
            <!-- 2: Нижная панель (Кнопка запуска) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Отображение пути к текущему файлу общих параметров -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Файл ФОП:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="TxtFopPath" IsReadOnly="True" Background="#F0F0F0" Padding="4,2"/>
        </Grid>

        <!-- 1. Таблица со списком параметров -->
        <ListView Grid.Row="1" x:Name="LvParameters" Margin="0,0,0,15">
            <ListView.View>
                <GridView>
                    <!-- Колонка выбора (Чекбокс) -->
                    <GridViewColumn Header="Выбор" Width="55">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Колонка с именем параметра -->
                    <GridViewColumn Header="Имя параметра" Width="240">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Колонка с именем группы из ФОП -->
                    <GridViewColumn Header="Группа параметров" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GroupName}" Foreground="Gray" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 2. Нижняя панель: Выбор группы и Кнопка запуска -->
        <Grid Grid.Row="2" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <!-- Левая колонка для списка: заберет всё оставшееся место -->
                <ColumnDefinition Width="*"/>
                <!-- Правая колонка для кнопки: по размеру ее содержимого -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Выпадающий список (растянется на всю ширину до кнопки) -->
            <ComboBox Grid.Column="0" 
                      x:Name="CbParameterGroups" 
                      Height="32" 
                      VerticalContentAlignment="Center" 
                      Margin="0,0,15,0"/>

            <!-- 2. Кнопка добавления (прижата к правому краю) -->
            <Button Grid.Column="1" 
                    x:Name="BtnAdd" 
                    Content="Добавить в семейство" 
                    Height="32" 
                    Padding="20,0" 
                    Click="BtnAdd_Click"/>
        </Grid>
    </Grid>
</Window>
